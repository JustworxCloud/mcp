# jwx-mcp REMOTE server config (src/http-entry.js). Copy to `.env`.
#
# NOTE: the remote server holds NO secret — it is a multi-tenant OAuth 2.1 Resource Server that
# forwards each caller's own token to the Justworx API. So this file has no credentials; it is safe.
# (The stdio server, by contrast, takes a single JWX_API_KEY — not used here.)

# The Justworx API the tools call. Tokens are forwarded here (it accepts either an API key
# or an OAuth token).
JWX_API_BASE_URL=https://api.justworx.com/api/v2

# Loopback port the server listens on; put your public HTTPS reverse proxy / tunnel in front of it
# to map mcp.justworx.com -> this.
MCP_HTTP_PORT=8791

# This server's PUBLIC url = its OAuth resource identifier (RFC 8707 token audience). Use the
# trailing slash to match the PRM (which advertises URL.href, i.e. `…/`) and the audience the client
# is registered with. (The verifier accepts either form regardless — src/oauth.js — but keep aligned.)
MCP_RESOURCE_URL=https://mcp.justworx.com/

# The OAuth authorization server whose access tokens we accept. Live + public.
OAUTH_ISSUER=https://oauth.justworx.com
OAUTH_JWKS_URL=https://oauth.justworx.com/.well-known/jwks.json
